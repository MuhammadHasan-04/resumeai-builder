# Environment Configuration for Profyl Backend

# ==================== SERVER CONFIGURATION ====================
PORT=3000
NODE_ENV=development
OPENROUTER_API=your_openrouter_api_key_here


# ==================== DATABASE CONFIGURATION ====================
# SQLite (default - no need to change unless using MySQL/PostgreSQL)
DB_NAME=profyl
DB_USER=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=sqlite

# ==================== JWT & SECURITY ====================
# Secret key for JWT signing - MUST BE AT LEAST 32 CHARACTERS IN PRODUCTION
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=your_jwt_secret_key_minimum_32_characters_long_for_production

# Token expiry
TOKEN_EXPIRY=7d

# ==================== FRONTEND CONFIGURATION ====================
# URL for password reset links and CORS
FRONTEND_URL=http://localhost:5173

# ==================== EMAIL CONFIGURATION (Optional) ====================
# For sending password reset emails - leave blank to skip email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@profyl.com

# ==================== FILE UPLOAD ====================
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# ==================== LOGGING ====================
LOG_LEVEL=debug
